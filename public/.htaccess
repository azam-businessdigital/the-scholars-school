# ==============================================================================
# The Scholars High School & Junior College for Commerce
# Apache / cPanel Production Configuration (Root & Subfolder Compatible)
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enforce HTTPS (Preserves full host and current URI)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Legacy 301 Redirects from previous PHP website
  RewriteRule ^index\.php$ ./ [R=301,L]
  RewriteRule ^about-us\.php$ about-us/ [R=301,L]
  RewriteRule ^pre-school-section\.php$ academics/mrak-kids/ [R=301,L]
  RewriteRule ^preschool\.php$ academics/mrak-kids/ [R=301,L]
  RewriteRule ^pre-primary-section\.php$ academics/pre-primary/ [R=301,L]
  RewriteRule ^primary-section\.php$ academics/primary/ [R=301,L]
  RewriteRule ^secondary-section\.php$ academics/secondary/ [R=301,L]
  RewriteRule ^deeniyat\.php$ academics/deeniyat/ [R=301,L]
  RewriteRule ^college-girls\.php$ academics/junior-college/girls/ [R=301,L]
  RewriteRule ^college-boys\.php$ academics/junior-college/boys/ [R=301,L]
  RewriteRule ^gallery\.php$ gallery/ [R=301,L]
  RewriteRule ^media-news\.php$ events/ [R=301,L]
  RewriteRule ^career\.php$ careers/ [R=301,L]
  RewriteRule ^contact-us\.php$ contact-us/ [R=301,L]

  # API Endpoints (relative rewrite)
  RewriteRule ^api/contact/?$ api/contact.php [L,QSA]
  RewriteRule ^api/admission-enquiry/?$ api/admission.php [L,QSA]

  # Block direct access to hidden files and sensitive extensions
  RewriteRule "(^|/)\.(?!well-known)" - [F]
  RewriteRule \.(env|git|sql|bak|log|tar|gz|zip)$ - [F,L]

  # SPA Routing Fallback: Serve existing files or fallback to index.html (relative)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; frame-src 'self' https://www.google.com https://maps.google.com https://www.google.com/recaptcha/ https://recaptcha.google.com;"
</IfModule>

# Disable caching for dynamic PHP endpoints and API requests
<FilesMatch "\.(php|json)$">
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </IfModule>
</FilesMatch>

# Caching for Static Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
